{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careech-admin",
  "compatibility_date": "2026-02-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careech-production",
      "database_id": "local-dev",
      "preview_database_id": "local-dev"
    }
  ],
  "miniflare": {
    "d1_persist": "../webapp/.wrangler/state/v3/d1"
  }
}
